{
  "run_name": "WildCat1",
  "paths": {
    "source": "dataset/source/source.####.exr",
    "target": "dataset/target/target.####.exr"
  },
  "model": {
    "model_size": "Medium",
    "in_channels": 3,
    "out_channels": 3,
    "n_levels": 3,
    "scale": 0.5
  },
  "train": {
    "epochs": 10000,
    "batch_size_auto": true,
    "batch_size": 8,
    "crop_size_auto": true,
    "crop_size": 256,
    "learning_rate": 0.0001,
    "lr_power": 0.3,
    "multi_resolution": true,
    "precision": "adaptive",
    "seed": 0,
    "initial_weights": "None",
    "resume": false
  },
  "optimizations": {
    "engine": "fast",
    "lossless": {
      "gpu_resident": "auto",
      "cuda_graph": true,
      "fused_adam": true,
      "channels_last": true,
      "cudnn_benchmark": true,
      "async_io": true,
      "preview_gpu": "auto"
    },
    "lossy": {
      "precision": "adaptive"
    }
  },
  "loss": {},
  "io": {
    "checkpoint_interval": 1000,
    "preview_enabled": true,
    "preview_interval": 100,
    "preview_size": 0,
    "log_interval": 10,
    "export_cat": true
  }
}